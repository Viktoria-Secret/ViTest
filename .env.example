# Database configuration
POSTGRES_DB=viktor
POSTGRES_USER=viktor
POSTGRES_PASSWORD=viktor_secret
DATABASE_URL=postgresql+psycopg://viktor:viktor_secret@db:5432/viktor

# Redis configuration
REDIS_URL=redis://redis:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=db+postgresql://viktor:viktor_secret@db:5432/viktor

# MikroTik router configuration
MIKROTIK_HOST=router.local
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_secure_password

# API configuration
API_KEY=your_secure_api_key